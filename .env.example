# Demo mode runs without any external service.
APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_DATABASE_PATH=.data/donelayer.sqlite
TASK_ANALYZER=rule-based

# Optional Supabase production adapter. Never expose the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional GitHub App integration.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Worker and executor feature flags.
DONELAYER_API_URL=http://localhost:3000
DONELAYER_ENABLE_CODEX_EXECUTOR=false
DONELAYER_CODEX_BIN=codex
DONELAYER_ARTIFACT_UPLOAD_HOSTS=localhost,127.0.0.1
DONELAYER_MCP_SERVERS=
WEBHOOK_AGENT_ALLOWLIST=
WEBHOOK_AGENT_CALLBACK_SECRET=

# Optional Stripe Connect skeleton; kept off for the MVP.
ENABLE_STRIPE_TEST_MODE=false
STRIPE_TEST_SECRET_KEY=
